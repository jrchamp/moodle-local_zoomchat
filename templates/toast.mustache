{{!
    @template local_zoomchat/toast

    Notification toast shown when a new message arrives while the modal is closed.

    Classes required for JS:
    * local-zoomchat-toast
    * toast-body

    Data attributes required for JS:
    * data-userid

    Context variables required for this template:
    * fromuserid number Sender user ID
    * sendername string Sender full name
    * preview string Message preview text
    * timestamp string Relative time text

    Example context (json):
    {
        "fromuserid": 42,
        "sendername": "John Doe",
        "preview": "Hello, how are you?",
        "timestamp": "now"
    }
}}
<div class="local-zoomchat-toast" role="alert" data-userid="{{fromuserid}}">
    <div class="toast-header">
        <strong class="me-auto">{{sendername}}</strong>
        <small class="text-muted ms-2">{{timestamp}}</small>
        <button type="button" class="btn-close" data-dismiss="toast" aria-label="{{#str}} close, local_zoomchat {{/str}}"></button>
    </div>
    <div class="toast-body text-break" role="button" tabindex="0">{{preview}}</div>
</div>
