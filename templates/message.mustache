{{!
    @template local_zoomchat/message

    A single chat message bubble, either sent by the current user or a contact.

    Classes required for JS:
    * local-zoomchat-msg
    * local-zoomchat-bubble

    Data attributes required for JS:
    * data-messageid
    * data-timestamp

    Context variables required for this template:
    * id number Message ID
    * message string Raw HTML of the message body
    * timestamp number Unix timestamp
    * timestampformatted string Formatted date/time string
    * mymessage boolean Whether the message was sent by the current user

    Example context (json):
    {
        "id": 1,
        "message": "Hello!",
        "timestamp": 1700000000,
        "timestampformatted": "2024-01-01 12:00",
        "mymessage": true
    }
}}
<li class="local-zoomchat-msg{{#mymessage}} local-zoomchat-msg-mine{{/mymessage}}{{^mymessage}} local-zoomchat-msg-theirs{{/mymessage}}"
    data-messageid="{{id}}" data-timestamp="{{timestamp}}">
    <div class="local-zoomchat-bubble">{{{message}}}</div>
    <div class="local-zoomchat-msg-time">{{timestampformatted}}</div>
</li>
