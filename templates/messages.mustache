{{!
    @template local_zoomchat/messages

    Renders a batch of chat messages in a single template render.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * messages array of objects, each with the same context as local_zoomchat/message

    Example context (json):
    {
        "messages": [
            {
                "id": 1,
                "message": "Hello!",
                "timestamp": 1700000000,
                "timestampformatted": "2024-01-01 12:00",
                "mymessage": true
            },
            {
                "id": 2,
                "message": "Hi there!",
                "timestamp": 1700000060,
                "timestampformatted": "2024-01-01 12:01",
                "mymessage": false
            }
        ]
    }
}}
{{#messages}}
{{> local_zoomchat/message}}
{{/messages}}
