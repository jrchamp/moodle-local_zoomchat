{{!
    @template local_zoomchat/conv_list_state

    Loading spinner or empty-state message for the conversation list.

    Classes required for JS:
    * local-zoomchat-loading
    * local-zoomchat-empty

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * loading boolean Whether to show the loading state
    * message string Text to display in the empty state

    Example context (json):
    {
        "loading": true,
        "message": ""
    }
}}
{{#loading}}
<div class="local-zoomchat-loading">{{#str}} sending, local_zoomchat {{/str}}</div>
{{/loading}}
{{^loading}}
<div class="local-zoomchat-empty">{{message}}</div>
{{/loading}}
